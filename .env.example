# ─────────────────────────────────────────────────────────────────────────────
# Channel Yield Analytics Agent — Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env with real secrets to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | testing | staging | production
CY_ENV=development

# ── Server ────────────────────────────────────────────────────────────────────
CY_HOST=127.0.0.1
CY_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
# Production: postgresql+psycopg2://user:password@host:5432/dbname
# Local dev:  sqlite+pysqlite:///./dev.sqlite  (single-tenant demo only)
# Testing:    sqlite+pysqlite:///:memory:
CY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 hex characters. NEVER use a default in production.
CY_SECRET_KEY=REPLACE_WITH_RANDOM_HEX_32_CHARS_MINIMUM

# JWT token lifetime in minutes (access token)
CY_ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT algorithm
CY_JWT_ALGORITHM=HS256

# ── Encryption (for stored OAuth tokens and API keys) ─────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep outside the database and outside source control.
CY_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ── Legacy single-tenant API support (backward-compat) ────────────────────────
# Set for the /v1/analytics endpoint used by the existing prototype / iGentic.
# When empty, legacy endpoint is disabled and multi-tenant auth is required.
CY_LEGACY_API_TOKEN=
CY_LEGACY_CLIENT_ID=
CY_LEGACY_DB_PATH=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use exact origins in production.
# Example: https://app.yourdomain.com,https://analytics.yourdomain.com
CY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Zoho Recruit OAuth ────────────────────────────────────────────────────────
# Register your OAuth app at: https://api-console.zoho.com/
# Redirect URI must match exactly what is registered in the Zoho console.
CY_ZOHO_CLIENT_ID=REPLACE_WITH_ZOHO_OAUTH_CLIENT_ID
CY_ZOHO_CLIENT_SECRET=REPLACE_WITH_ZOHO_OAUTH_CLIENT_SECRET
CY_ZOHO_REDIRECT_URI=http://localhost:8080/v2/integrations/zoho/callback
# Data center: com | eu | in | au | jp | ca  (default: com)
CY_ZOHO_DATA_CENTER=com

# ── Language Model Provider ───────────────────────────────────────────────────
# Provider: openai | anthropic | none
# When set to "none", the /v2/agent endpoints return a 503 with explanation.
CY_LLM_PROVIDER=none
CY_LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
CY_LLM_MODEL=gpt-4o-mini

# ── Upload limits ─────────────────────────────────────────────────────────────
CY_MAX_UPLOAD_BYTES=52428800
CY_MAX_CSV_ROWS=100000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requests per minute per IP for unauthenticated endpoints
CY_RATE_LIMIT_ANON=60
# Requests per minute per authenticated identity for analytics/agent endpoints
CY_RATE_LIMIT_AUTHED=300

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
CY_LOG_LEVEL=INFO
